# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase public web config for AfriSell.
VITE_FIREBASE_API_KEY="AIzaSyCdqNyHc2Fgr3brSc5oWR1ucEYzi_4rza4"
VITE_FIREBASE_AUTH_DOMAIN="afrisellapp.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="afrisellapp"
VITE_FIREBASE_STORAGE_BUCKET="afrisellapp.firebasestorage.app"
VITE_FIREBASE_DATABASE_URL="https://afrisellapp-default-rtdb.firebaseio.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="582531352090"
VITE_FIREBASE_APP_ID="1:582531352090:web:9d42ce03733cc885f7f3a3"
VITE_FIREBASE_MEASUREMENT_ID="G-X2LJE0WH51"

# Required only for Android APK native Google sign-in.
# Firebase Console > Project settings > General > Web client ID.
VITE_GOOGLE_WEB_CLIENT_ID="YOUR_FIREBASE_WEB_CLIENT_ID.apps.googleusercontent.com"

# Cloudinary signed uploads. Keep secret values server-side only.
CLOUDINARY_CLOUD_NAME="dh0ilegll"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
CLOUDINARY_URL="cloudinary://YOUR_CLOUDINARY_API_KEY:YOUR_CLOUDINARY_API_SECRET@dh0ilegll"
CLOUDINARY_UPLOAD_FOLDER="afrissel/users"
VITE_CLOUDINARY_CLOUD_NAME="dh0ilegll"
# Required for APK/native builds when the app is not served from the same web origin.
VITE_CLOUDINARY_SIGN_UPLOAD_URL="https://afri.afrisell.app/api/cloudinary/sign-upload"

# Wonyapay is used only by AfriSpay for Mobile Money cash-in/cash-out.
# Keep WONYAPAY_* server-side only. Do not expose them with VITE_.
WONYAPAY_BASE_URL="https://app-api.wonyasoft.com"
WONYAPAY_TOKEN="YOUR_WONYAPAY_TOKEN"
WONYAPAY_REF_PARTENAIRE="YOUR_WONYAPAY_REF_PARTENAIRE"
# Required for APK/native builds when calling AfriSell server payment routes.
VITE_WONYAPAY_API_BASE_URL="https://afri.afrisell.app"
