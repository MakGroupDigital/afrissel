{
  "rewrites": [
    {
      "source": "/share/zandofy/:storeId/:productId",
      "destination": "/api/share/zandofy-product?storeId=:storeId&productId=:productId"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
