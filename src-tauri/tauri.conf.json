{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AfriSell",
  "version": "1.0.2",
  "identifier": "com.makgroupdigital.afrissel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:2020",
    "beforeDevCommand": "npm run dev:tauri-web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AfriSell",
        "width": 430,
        "height": 932,
        "minWidth": 390,
        "minHeight": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
